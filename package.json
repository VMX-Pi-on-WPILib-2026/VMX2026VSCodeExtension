{
  "name": "vmx2026",
  "displayName": "VMX-Pi WPILib 2026",
  "description": "Installs the VMX-pi HAL and GradleRIO releases, switches WPILib 2026 projects between RoboRIO and VMX-pi, and saves them for offline builds",
  "icon": "resources/VMX_128.png",
  "publisher": "vmx-pi-on-wpilib-2026",
  "version": "2.0.7",
  "repository": {
    "type": "git",
    "url": "https://github.com/VMXONWPI/VMX2026VSCodeExtension"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onCommand:vmx2026.setVMXPiTarget",
    "onCommand:vmx2026.setRoboRIOTarget",
    "onCommand:vmx2026.updateVersion",
    "onCommand:vmx2026.saveOffline",
    "onCommand:vmx2026.openCommandPalette"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "vmx2026.setVMXPiTarget",
        "title": "Change the deploy target to VMX-Pi (from RoboRIO)",
        "category": "VMX2026"
      },
      {
        "command": "vmx2026.setRoboRIOTarget",
        "title": "Change the deploy target to RoboRIO (from VMX-Pi)",
        "category": "VMX2026"
      },
      {
        "command": "vmx2026.updateVersion",
        "title": "Update VMX2026 Version",
        "category": "VMX2026"
      },
      {
        "command": "vmx2026.saveOffline",
        "title": "Save VMX2026 Offline",
        "category": "VMX2026"
      },
      {
        "command": "vmx2026.openCommandPalette",
        "title": "Open VMX2026 Command Palette",
        "category": "VMX2026",
        "icon": "resources/VMX_128.png"
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "vmx2026.openCommandPalette",
          "when": "false"
        }
      ],
      "editor/title": [
        {
          "command": "vmx2026.openCommandPalette",
          "group": "navigation@9"
        }
      ]
    },
    "configuration": {
      "title": "VMX2026",
      "properties": {
        "vmx2026.gradleRIORepository": {
          "type": "string",
          "default": "VMXONWPI/GradleRIO",
          "description": "GitHub owner/repo containing the prebuilt GradleRIO releases."
        },
        "vmx2026.allwpilibRepository": {
          "type": "string",
          "default": "VMXONWPI/allwpilib",
          "description": "GitHub owner/repo containing the prebuilt VMX HAL releases."
        },
        "vmx2026.includePrereleases": {
          "type": "boolean",
          "default": true,
          "description": "Include prereleases when selecting the newest compatible release pair."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "node node_modules/typescript/bin/tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "node node_modules/eslint/bin/eslint.js src --ext ts",
    "test": "node node_modules/mocha/bin/mocha --ui tdd \"out/test/unit/**/*.test.js\""
  },
  "devDependencies": {
    "@types/mocha": "^8.0.4",
    "@types/node": "20.17.0",
    "@types/node-fetch": "^2.5.8",
    "@types/vscode": "1.85.0",
    "@typescript-eslint/eslint-plugin": "^4.14.1",
    "@typescript-eslint/parser": "^4.14.1",
    "eslint": "^7.19.0",
    "mocha": "^8.2.1",
    "typescript": "5.6.3"
  },
  "dependencies": {
    "node-fetch": "^2.7.0"
  }
}
